DATABASE_URL=postgres://gymtracker:changeme@localhost:5432/gymtracker
PORT=3000

# Better Auth
BETTER_AUTH_SECRET=changeme-generate-a-real-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated list of origins allowed to call the auth API: the deployed
# web app, and the Capacitor app's origins (https://localhost for Android,
# capacitor://localhost for iOS).
TRUSTED_ORIGINS=http://localhost:3000,https://localhost,capacitor://localhost

# SMTP (magic link + password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google OAuth (Google Cloud Console, not Firebase) — one client per platform.
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_SECRET=
